DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: enables the "Recognize photo" feature via Claude Vision.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Vercel Blob storage token for photo uploads.
# Get one at https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Optional: enables the in-app AI assistant chat widget via Groq's free API.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=""
