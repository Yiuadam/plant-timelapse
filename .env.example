DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: enables the "Recognize photo" feature via Claude Vision.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Vercel Blob storage token for photo uploads.
# Get one at https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Optional: enables the in-app AI assistant chat widget via Groq's free API.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=""

# Optional: enables "Continue with Google" on the login/register pages.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) and add <your-domain>/api/auth/callback/google
# as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: enables "Continue with Apple". Requires a paid Apple Developer
# Program membership. Create a Services ID (this is APPLE_ID below) at
# https://developer.apple.com/account/resources/identifiers/list/serviceId,
# add <your-domain>/api/auth/callback/apple as a return URL, then create a
# "Sign in with Apple" key to get APPLE_KEY_ID and a downloaded .p8 private
# key (its contents go in APPLE_PRIVATE_KEY). APPLE_TEAM_ID is on the
# Membership page. The app derives a short-lived client secret from these
# automatically, so there's no separate secret to rotate every 6 months.
APPLE_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
