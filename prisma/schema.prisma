// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  birthday      DateTime?
  gender        String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  trips    Trip[]
  widgets  Widget[]

  collaborations TripCollaborator[]
  editLocks      EditLock[]
  cardPresences  CardPresence[]
  passportStamps PassportStamp[]
  translations   Translation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Trip {
  id             String    @id @default(cuid())
  userId         String
  title          String
  destination    String?
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  mood           String?
  shareToken     String?   @unique
  // An optional overall spending target the budget calculator compares
  // the sum of BudgetItems against -- null means "no target set", not
  // "$0 budget".
  budgetTarget   Float?
  budgetCurrency String?   @default("USD")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations      Location[]
  photos         Photo[]
  collaborators  TripCollaborator[]
  travelItems    TravelItem[]
  passportStamps PassportStamp[]
  budgetItems    BudgetItem[]
}

model TripCollaborator {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

// A short-lived claim that a user is actively editing one field/resource,
// used to show other viewers a "someone's editing this" indicator and
// prevent simultaneous edits from silently overwriting each other. Expires
// on its own (heartbeat-refreshed while focused) so a crashed tab can't
// leave a permanent lock.
model EditLock {
  id           String   @id @default(cuid())
  resourceType String
  resourceId   String
  userId       String
  userName     String
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceType, resourceId])
}

// Passive "who's looking at this" presence -- unlike EditLock this is not
// exclusive, any number of users can watch the same card at once.
model CardPresence {
  id           String   @id @default(cuid())
  userId       String
  userName     String
  userImage    String?
  resourceType String
  resourceId   String
  cardKey      String
  lastSeenAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, resourceId, cardKey])
  @@index([resourceType, resourceId, cardKey])
}

// A stamp a user has manually pressed into their passport for a trip's
// destination. Each collaborator on a shared trip can stamp it into their
// own passport independently -- @@unique is per (userId, tripId), not
// tripId alone.
model PassportStamp {
  id        String   @id @default(cuid())
  userId    String
  tripId    String
  city      String
  stampedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([userId, tripId])
}

model Location {
  id        String    @id @default(cuid())
  tripId    String
  name      String
  notes     String?
  lat       Float
  lng       Float
  visited   Boolean   @default(true)
  visitedAt DateTime?
  cardStyle String?   @default("clean")
  cardSize  String?   @default("md")
  createdAt DateTime  @default(now())

  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  photos Photo[]
}

model Photo {
  id           String    @id @default(cuid())
  tripId       String
  locationId   String?
  filePath     String
  caption      String?
  recognizedAt DateTime?
  recognition  String?
  createdAt    DateTime  @default(now())

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
}

// A booking a user wants to keep track of for a trip — a flight, hotel
// stay, or train ride. `type` is a free string rather than a Prisma enum
// so new travel types can be added without a migration.
model TravelItem {
  id        String    @id @default(cuid())
  tripId    String
  type      String
  title     String
  detail    String?
  location  String?
  startAt   DateTime
  endAt     DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// A single line item in a trip's budget calculator -- "Flight to Tokyo:
// $450", "Hotel: $600". category is a free string (not a Prisma enum) for
// the same reason TravelItem.type is, so new categories don't need a
// migration; the UI offers a fixed set of common ones as a select.
model BudgetItem {
  id        String   @id @default(cuid())
  tripId    String
  category  String
  label     String
  amount    Float
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Widget {
  id        String   @id @default(cuid())
  userId    String
  // Which board this widget lives on -- "desktop" or "mobile". The two are
  // independent: rearranging/adding/removing widgets on one device never
  // touches the other's layout, since a phone screen can't sensibly fit
  // the same large, dense desktop board.
  device    String   @default("desktop")
  type      String
  x         Float    @default(5)
  y         Float    @default(5)
  w         Int      @default(260)
  h         Int      @default(220)
  rotation  Float    @default(0)
  zIndex    Int      @default(1)
  color     String?
  style     String?  @default("clean")
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, device])
}

// A camera/photo translation: an uploaded image of foreign-language text,
// the language Claude detected, the transcribed original, and its English
// translation. Kept as history so a user can revisit past translations.
model Translation {
  id               String   @id @default(cuid())
  userId           String
  imageUrl         String?
  detectedLanguage String?
  originalText     String?
  translatedText   String?
  explanation      String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Curated city -> landmark-icon mapping for passport stamps, seeded from
// src/data/landmark-seed.json (see prisma/seed-landmarks.mjs, wired into
// the build script). landmarkKey is either one of the ~25 bespoke keys
// rendered by CuratedLandmarkIcon (e.g. "eiffel-tower") or one of the
// broader archetype keys rendered by ArchetypeLandmarkIcon (e.g.
// "cathedral-spire") -- both live in src/components/landmark-icons.tsx.
model Landmark {
  id          String   @id @default(cuid())
  cityKey     String   @unique
  displayName String
  landmarkKey String
  inkOverride String?
  createdAt   DateTime @default(now())
}

// A curated multilingual word/phrase dictionary, seeded from
// src/data/dictionary-seed.json (see prisma/seed-dictionary.mjs). Backs
// three things: (1) an instant, free lookup the /api/translate route tries
// before falling back to the Claude API, (2) the site's own /translate
// page, and (3) a public read-only API (/api/dictionary) meant to be
// reused from other projects, not just this one.
model DictionaryEntry {
  id           String   @id @default(cuid())
  key          String   @unique
  category     String?
  translations Json
  createdAt    DateTime @default(now())

  @@index([category])
}
